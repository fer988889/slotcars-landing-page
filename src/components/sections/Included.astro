---
import StoryPanel from '../StoryPanel.astro';
import type { StoryPanelProps } from '../../types/video-story';

type Props = StoryPanelProps;
---
<StoryPanel {...Astro.props}>
  <h2>Todo incluido</h2>
  <ul class="features">
    <li>Pista armada a la medida de tu espacio</li>
    <li>Autos y controles para todos</li>
    <li>Obstáculos, rampas y cronometraje</li>
    <li>Staff que arma, guía y desarma</li>
  </ul>
  <a class="btn" href="#contacto">Ver disponibilidad</a>
</StoryPanel>

<style>
  .features { padding-left: 1.2rem; margin-bottom: 1.5rem; display: grid; gap: .6rem; font-size: 1.15rem; }
</style>
