---
import type { StoryPanelProps } from '../types/video-story';

type Props = StoryPanelProps;

const { scene, time, focus, align = 'center' } = Astro.props;
---
<div
  class:list={['panel', `panel--${align}`]}
  data-panel
  data-scene={scene}
  data-time={time}
  data-focus-x={focus?.x}
  data-focus-y={focus?.y}
>
  <slot />
</div>

<style>
  .panel { position: absolute; inset: 0; z-index: 2; display: grid; place-content: center; justify-items: center; padding: 0 5vw; text-align: center; text-shadow: 0 2px 20px #0008; opacity: 0; visibility: hidden; }
  .panel :global(p) { max-width: 38ch; margin: 0 auto 1.5rem; font-size: 1.15rem; }
  .panel--right { place-content: center end; justify-items: start; padding-right: 6vw; text-align: left; }
  .panel--right > :global(*) { max-width: 30vw; }
</style>
