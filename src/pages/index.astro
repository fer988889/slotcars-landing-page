---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import VideoStory from '../components/VideoStory.astro';
import Contact from '../components/sections/Contact.astro';
import Hero from '../components/sections/Hero.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import Included from '../components/sections/Included.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import type { StoryScene } from '../types/video-story';

const scenes: StoryScene[] = [
  { name: 'intro', video: 'hero', start: 1.3 },
  { name: 'servicios', video: 'slot-cars-video-2' },
  { name: 'testimonios', video: 'slot-cars-video-3', transition: 'cut', align: { y: 2.2 } },
];

const sections = [
  { id: 'inicio', label: 'Inicio' },
  { id: 'como-funciona', label: 'Cómo funciona' },
  { id: 'incluido', label: 'Qué incluye' },
  { id: 'testimonios', label: 'Testimonios' },
];
---
<Base title="Slotcars | Pistas de autos a control remoto para tu evento" description="Llevamos la pista, los obstáculos y los autos a control remoto a tu evento.">
  <Nav sections={sections} />

  <VideoStory scenes={scenes}>
    <Hero id="inicio" scene="intro" />
    <HowItWorks id="como-funciona" scene="intro" />
    <Included id="incluido" scene="servicios" time={2.37} focus={{ x: 50, y: 56 }} align="right" />
    <Testimonials id="testimonios" scene="testimonios" />
  </VideoStory>

  <Contact />
  <Footer />

  <script>
    import '../scripts/main.ts';
  </script>
</Base>
