---
import type { BaseProps } from '../types/layout';

type Props = BaseProps;
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline>
      history.scrollRestoration = 'manual';
      document.documentElement.classList.add('is-loading');
      document.addEventListener('click', function (event) {
        if (!document.documentElement.classList.contains('is-loading')) return;
        var link = event.target.closest && event.target.closest('a[href^="#"]');
        if (!link) return;
        event.preventDefault();
        event.stopImmediatePropagation();
        window.__pendingLink = link;
      }, true);
    </script>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700&display=swap" />
  </head>
  <body>
    <slot />
  </body>
</html>
<style is:global>
  :root { --bg:#0b0d14; --fg:#f4f5f8; --accent:#ff3d2e; --accent2:#ffc83d; }
  * { box-sizing: border-box; margin: 0; }
  html.lenis, html.lenis body { height: auto; }
  html.lenis-stopped { overflow: hidden; }
  html.is-loading, html.is-loading body { overflow: hidden; touch-action: none; }
  html { scrollbar-width: none; }
  html::-webkit-scrollbar { display: none; }
  body { background: var(--bg); color: var(--fg); font-family: system-ui, sans-serif; overflow-x: hidden; }
  a { color: inherit; }
  h1 { font-size: clamp(2.5rem, 8vw, 6rem); line-height: 1; margin-bottom: 1rem; }
  h2 { font-size: clamp(2rem, 5vw, 3.5rem); margin-bottom: 1rem; }
  .btn { background: var(--accent); color: #fff; padding: .6rem 1.2rem; border-radius: 999px; text-decoration: none; font-weight: 700; display: inline-block; }
  .btn.big { padding: .9rem 2rem; font-size: 1.1rem; }
  .btn--ghost { background: transparent; border: 2px solid currentColor; }
</style>
